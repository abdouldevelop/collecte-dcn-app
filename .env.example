# SMTP_SECURE="false"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@collecte-dcn.gov"
SMTP_SECURE="false"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="replace-with-a-long-random-secret"
# Relances envoyées à J-7, J-3, J-1, le jour J, puis chaque jour après échéance.
REMINDER_DAYS_BEFORE="7,3,1,0"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET="dcn-uploads"
NODE_ENV="development"
